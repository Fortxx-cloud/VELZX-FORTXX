# VELZX AI - Environment Template

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# API key hashing secret
# Generate a stable random secret. Do not regenerate after issuing API keys.
FORTXX_KEY_PEPPER=REPLACE_WITH_STABLE_BASE64URL_SECRET

# Optional Hybrid Settings
# Defaults are defined in config/runtime-settings.json.
# Uncomment only when an override is needed.

# VELZX_PROVIDER_TIMEOUT_MS=30000
# VELZX_KEY_COOLDOWN_MS=30000
# VELZX_CREDENTIAL_COOLDOWN_MS=300000
# VELZX_RATE_LIMIT_COOLDOWN_MS=30000
# VELZX_MAX_ATTEMPTS=3
# VELZX_HTTP_MAX_BODY_BYTES=1048576
# VELZX_DB_POOL_MAX=5
# VELZX_DB_IDLE_TIMEOUT_MS=30000
# VELZX_DB_CONNECTION_TIMEOUT_MS=20000

# PORT and SERVER_PORT are supplied by the hosting platform.
# Groq credentials are loaded from the external VELZX-API-LABORATORIUM/.env.
